<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Test fixture only: exports one fixed scratch file, never included in the launcher APK. -->
        <provider android:name="cn.wengmang.qiping.tests.MaintenanceExportProvider" android:authorities="cn.wengmang.qiping.tests.export" android:exported="true" />
        <activity android:name="cn.wengmang.qiping.tests.ProbeActivity" android:exported="true" android:label="Qiping Test App" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="qiping-test-update" android:host="details" />
            </intent-filter>
        </activity>
    </application>
</manifest>
